# ── Frontend (Vite) ──────────────────────────────────────────────
# Public Supabase project URL + anon key. Safe to expose in the browser.
# The app runs on deterministic sample data until these are set.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Edge function secrets (set with `supabase secrets set`) ───────
# Never expose these in the frontend.
#   ANTHROPIC_API_KEY   – required for the scenarios + advice functions
#   ANTHROPIC_MODEL     – optional, defaults to claude-sonnet-4-6
#   OPENAQ_API_KEY      – optional, enables air-quality indicators (openaq.org)
#   GFW_API_KEY         – optional, enables Global Forest Watch indicators
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically into
# edge functions by the platform — do not set them yourself.
