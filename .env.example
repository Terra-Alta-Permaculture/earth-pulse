# EarthPulse runs on all-live, keyless public APIs — the dashboard itself
# needs NO environment variables. Everything below is optional and only
# powers the Vercel serverless extras (the weekly auto-writers + AI panels).

# ── Serverless functions (api/*) ─────────────────────────────────
# Required only for the AI panels and the weekly World Pulse / law writers.
ANTHROPIC_API_KEY=
# Optional — defaults to a current Claude model in code.
ANTHROPIC_MODEL=
# Optional — if set, cron endpoints require this as a bearer token.
CRON_SECRET=
# BLOB_READ_WRITE_TOKEN is injected automatically by Vercel Blob — don't set it.

# ── Frontend overrides (Vite) ────────────────────────────────────
# Optional. Default to the bundled /api/* routes; only set to point the
# client at different endpoints.
VITE_AI_ENDPOINT=
VITE_LAW_ENDPOINT=
VITE_WORLD_ENDPOINT=
VITE_WORLD_REPORT_URL=
